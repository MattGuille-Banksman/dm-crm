# Copy to .env on the server and fill in. Never commit the real .env.

# Web address of the CRM. Without your own domain, use <server-ip>.sslip.io
# (e.g. 132.145.10.20.sslip.io): it points at the server and gets a free
# HTTPS certificate. With a domain, point an A record at the server IP and
# put the name here (e.g. crm.dm4u.ai).
DOMAIN=

# Long random values, e.g. from: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=

# Outgoing email (needed for campaigns, invitations and password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
